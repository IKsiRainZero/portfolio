# === Portfolio App 环境配置 ===
# 复制此文件为 .env 并填写你的配置

# === LLM 提供商 ===
# "local" = Ollama 本地模型（默认，省 token）
# "deepseek" = DeepSeek API（需填写 API Key）
LLM_PROVIDER=local
LOCAL_MODEL_NAME=llama3.1:8b
LOCAL_COMPRESS_MODEL=qwen2.5:0.5b

# DeepSeek API Key（LLM_PROVIDER=deepseek 时必填，https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 本地模型存放目录（可选，默认项目内 ./models/）
# MODELS_DIR=./models

# Reranker 精排（可选，开启后检索精度更高但首次需下载 ~1.3GB 模型）
# USE_RERANKER=true

# Ollama 本地模型（可选，用于 Agent 历史压缩，需先安装 Ollama）
# 启用后自动使用 qwen2.5:0.5b 压缩对话历史，不消耗 API token
